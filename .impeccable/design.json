    "typographyMeta": {
      "display": {
        "displayName": "Display",
        "purpose": "Título do destaque na vitrine de Lives."
      },
      "headline": {
        "displayName": "Headline",
        "purpose": "Título de seção e título do vídeo na Revisão."
      },
      "title": {
        "displayName": "Title",
        "purpose": "Nome do streamer na prateleira e nome do espaço travado."
      },
      "body": {
        "displayName": "Body",
        "purpose": "Texto base e metadados."
      },
      "body-strong": {
        "displayName": "Body strong",
        "purpose": "Títulos de card e de item, botões e chips."
      },
      "label": {
        "displayName": "Label",
        "purpose": "Rótulos de passo, tier, 'Na sua mesa'; caixa normal."
      },
      "caption": {
        "displayName": "Caption",
        "purpose": "Duração e Nº sobre a thumb, eixos, contagens; numerais tabulares."
      }
    },
    "fonts": [
      {
        "family": "Onest",
        "source": "assets/fonts/onest-latin.woff2, assets/fonts/onest-latin-ext.woff2",
        "weights": "100 900 (variável)",
        "display": "swap"
      }
    ],
    "shadows": [
      {
        "name": "flutuante",
        "value": "0 10px 30px rgba(0,0,0,.45), 0 0 0 .5px rgba(255,255,255,.08)",
        "valueClaro": "0 10px 30px rgba(0,0,0,.12), 0 0 0 .5px rgba(0,0,0,.08)",
        "purpose": "Sidebar aberta flutuando sobre o conteúdo (--sombra)."
      },
      {
        "name": "folha",
        "value": "0 0 0 .5px var(--fio), 0 1px 2px rgba(0,0,0,.06)",
        "purpose": "Painéis e fichas."
      },
      {
        "name": "controle",
        "value": "0 0 0 .5px var(--fio-forte), 0 1px 1px rgba(0,0,0,.08)",
        "purpose": "Chips e botão secundário."
      },
      {
        "name": "segmento-selecionado",
        "value": "0 1px 3px rgba(0,0,0,.18), 0 0 0 .5px var(--fio)",
        "purpose": "Segmento ativo sobre o trilho do controle segmentado."
      },
      {
        "name": "botao-principal",
        "value": "inset 0 .5px 0 rgba(255,255,255,.22), 0 1px 2px rgba(0,0,0,.2)",
        "purpose": "Brilho de meio pixel no topo do laranja queimado."
      },
      {
        "name": "poco",
        "value": "inset 0 0 0 .5px var(--fio)",
        "purpose": "Superfície rebaixada do travado."
      },
      {
        "name": "foco",
        "value": "outline: 3px solid var(--foco); outline-offset: 1px",
        "purpose": "Anel de :focus-visible."
      }
    ],
    "materials": [
      {
        "name": "trilho",
        "value": "background: var(--trilho); backdrop-filter: blur(30px) saturate(180%)",
        "purpose": "Sidebar translúcida."
      },
      {
        "name": "rotulo-sobre-thumb",
        "value": "background: var(--material); backdrop-filter: blur(14px) saturate(160%); color: #fff",
        "purpose": "Nº, duração e selo sobre miniaturas."
      },
      {
        "name": "vaga-de-render",
        "value": "background: rgba(20,20,22,.55); backdrop-filter: blur(10px) saturate(140%)",
        "purpose": "Thumb em render, com progresso laranja de 4px."
      }
    ],
    "motion": [
      {
        "name": "ease-sistema",
        "value": "cubic-bezier(.2,.8,.2,1)",
        "purpose": "Saída suave padrão (sidebar, encaixe)."
      },
      {
        "name": "hover",
        "value": "150ms",
        "purpose": "Troca de fundo em hover de botão e card."
      },
      {
        "name": "sidebar-abrir",
        "value": "width 200ms cubic-bezier(.2,.8,.2,1), delay 150ms",
        "purpose": "Sidebar desliza por cima do conteúdo; fecha sem espera."
      },
      {
        "name": "colar-encaixe",
        "value": "220ms cubic-bezier(.2,.8,.2,1); scale .965 → 1.008 → 1, opacity .5 → 1",
        "purpose": "Assinatura 'colar a figurinha': o card pronto encaixa."
      },
      {
        "name": "colar-brilho",
        "value": "900ms cubic-bezier(.45,0,.55,1), delay 120ms; faixa de 42% em soft-light de -120% a 340%",
        "purpose": "Faixa de brilho atravessando a thumb ao colar."
      },
      {
        "name": "esqueleto",
        "value": "1.6s ease-in-out infinite, opacity até .55",
        "purpose": "Carregamento das prateleiras."
      },
      {
        "name": "reduced-motion",
        "value": "animation: none; transition: none",
        "purpose": "prefers-reduced-motion troca o estado sem encaixe nem brilho."
      }
    ],
    "breakpoints": [
      {
        "name": "alvo",
        "value": "2560px",
        "purpose": "Desktop 2560×1440; só desktop, sem layout de celular."
      },
      {
        "name": "prateleira-larga",
        "value": "2200px",
        "purpose": "Prateleiras crescem até n × 480px."
      }
    ]
  },
  "components": [
    {
      "name": "Botão principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ação principal da tela em laranja queimado com texto branco; uma por contexto.",
      "html": "<button class=\"ds-btn\">Abrir na Sala do vídeo</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:7px;height:34px;padding:0 16px;border:0;border-radius:var(--raio-ctrl,7px);background:var(--acao,#CF4520);color:var(--acao-tinta,#FFFFFF);font:600 14px/1 Onest,system-ui,sans-serif;box-shadow:inset 0 .5px 0 rgba(255,255,255,.22),0 1px 2px rgba(0,0,0,.2);cursor:pointer;transition:background .15s}.ds-btn:hover{background:var(--acao-hover,#BC3B17)}.ds-btn:focus-visible{outline:3px solid var(--foco,rgba(255,106,61,.55));outline-offset:1px}"
    },
    {
      "name": "Botão secundário",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Ação de apoio em folha com contorno de meio pixel.",
      "html": "<button class=\"ds-btn-sec\">Configurar</button>",
      "css": ".ds-btn-sec{display:inline-flex;align-items:center;height:34px;padding:0 16px;border:0;border-radius:var(--raio-ctrl,7px);background:var(--folha,#2C2C2E);color:var(--tinta,#F5F5F7);font:600 14px/1 Onest,system-ui,sans-serif;box-shadow:0 0 0 .5px var(--fio-forte,rgba(255,255,255,.16)),0 1px 1px rgba(0,0,0,.08);cursor:pointer;transition:background .15s}.ds-btn-sec:hover{background:var(--folha-2,#3A3A3C)}.ds-btn-sec:focus-visible{outline:3px solid var(--foco,rgba(255,106,61,.55));outline-offset:1px}"
    },
    {
      "name": "Chip da mesa",
      "kind": "chip",
      "refersTo": "chip-mesa",
      "description": "Pendência na faixa 'Na sua mesa' com contagem em cápsula; a variante de alerta pinta a cápsula de vermelho.",
      "html": "<a class=\"ds-chip ds-alerta\" href=\"#\">Pede você <b>1</b></a> <a class=\"ds-chip\" href=\"#\">Revisar <b>2</b></a>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:8px;height:30px;padding:0 6px 0 12px;border-radius:var(--raio-ctrl,7px);background:var(--folha,#2C2C2E);color:var(--tinta,#F5F5F7);font:500 14px/1 Onest,system-ui,sans-serif;text-decoration:none;box-shadow:0 0 0 .5px var(--fio-forte,rgba(255,255,255,.16)),0 1px 1px rgba(0,0,0,.08)}.ds-chip:hover{background:var(--folha-2,#3A3A3C)}.ds-chip:focus-visible{outline:3px solid var(--foco,rgba(255,106,61,.55));outline-offset:1px}.ds-chip b{min-width:20px;height:20px;padding:0 6px;border-radius:10px;background:var(--capsula,rgba(255,255,255,.12));color:var(--capsula-tinta,#D1D1D6);font-size:12px;font-weight:600;display:grid;place-items:center;font-variant-numeric:tabular-nums}.ds-chip.ds-alerta b{background:var(--alerta-fundo,#CC2E24);color:#fff}"
    },
    {
      "name": "Controle segmentado",
      "kind": "custom",
      "refersTo": "segmented-track",
      "description": "Escolha exclusiva entre vistas; segmento travado leva cadeado.",
      "html": "<div class=\"ds-seg\" role=\"tablist\"><button role=\"tab\" aria-selected=\"false\"><svg viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"11\" width=\"14\" height=\"10\" rx=\"2\"/><path d=\"M8 11V7a4 4 0 0 1 8 0v4\"/></svg>Ao vivo</button><button role=\"tab\" aria-selected=\"false\">Em alta</button><button role=\"tab\" aria-selected=\"true\">Recentes</button></div>",
      "css": ".ds-seg{display:inline-flex;gap:2px;padding:3px;border-radius:9px;background:var(--capsula,rgba(255,255,255,.12))}.ds-seg button{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 14px;border:0;border-radius:var(--raio-ctrl,7px);background:none;color:var(--tinta-2,#C7C7CC);font:500 14px/1 Onest,system-ui,sans-serif;cursor:pointer}.ds-seg button:hover{color:var(--tinta,#F5F5F7)}.ds-seg button:focus-visible{outline:3px solid var(--foco,rgba(255,106,61,.55));outline-offset:1px}.ds-seg button[aria-selected=true]{background:var(--folha,#2C2C2E);color:var(--tinta,#F5F5F7);box-shadow:0 1px 3px rgba(0,0,0,.18),0 0 0 .5px var(--fio,rgba(255,255,255,.09))}.ds-seg svg{width:12px;height:12px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;opacity:.7}"
    },
    {
      "name": "Item da sidebar",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "Item de navegação no trilho translúcido; ativo com véu de seleção e ícone no laranja vivo; contagem em cápsula.",
      "html": "<nav class=\"ds-side\"><a class=\"ds-it\" aria-current=\"page\" href=\"#\"><svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M10 9l4 2-4 2z\"/></svg>Lives</a><a class=\"ds-it\" href=\"#\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 7h16M4 12h16M4 17h10\"/></svg>Fila<span>1</span></a><a class=\"ds-it\" href=\"#\"><svg viewBox=\"0 0 24 24\"><circle cx=\"9\" cy=\"8\" r=\"3\"/><path d=\"M3 19c0-3 3-5 6-5s6 2 6 5\"/></svg>Fontes<span class=\"ds-al\">1</span></a></nav>",
      "css": ".ds-side{width:264px;padding:12px 8px;display:flex;flex-direction:column;gap:1px;background:var(--trilho,rgba(40,40,42,.78));-webkit-backdrop-filter:blur(30px) saturate(180%);backdrop-filter:blur(30px) saturate(180%);border-right:.5px solid var(--fio-forte,rgba(255,255,255,.16))}.ds-it{display:flex;align-items:center;gap:12px;height:36px;padding:0 16px;border-radius:8px;color:var(--tinta-2,#C7C7CC);font:500 14px/1 Onest,system-ui,sans-serif;text-decoration:none}.ds-it svg{width:18px;height:18px;fill:none;stroke:var(--tinta-3,#8E8E93);stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.ds-it:hover{background:var(--capsula,rgba(255,255,255,.12))}.ds-it:focus-visible{outline:3px solid var(--foco,rgba(255,106,61,.55));outline-offset:1px}.ds-it[aria-current=page]{background:var(--selecao,rgba(255,106,61,.16));color:var(--tinta,#F5F5F7)}.ds-it[aria-current=page] svg{stroke:var(--marca,#FF6A3D)}.ds-it span{margin-left:auto;min-width:17px;height:17px;padding:0 5px;border-radius:9px;background:var(--capsula,rgba(255,255,255,.12));color:var(--capsula-tinta,#D1D1D6);font-size:11px;font-weight:600;display:grid;place-items:center;font-variant-numeric:tabular-nums}.ds-it span.ds-al{background:var(--alerta-fundo,#CC2E24);color:#fff}"
    },
    {
      "name": "Etiqueta de tier",
      "kind": "chip",
      "refersTo": "tier-tag",
      "description": "Bolinha + nome, à maneira do Finder: Ouro, Forte, Experimental (anel vazio).",
      "html": "<span class=\"ds-tier ds-ouro\">Ouro</span> <span class=\"ds-tier\">Forte</span> <span class=\"ds-tier ds-exp\">Experimental</span>",
      "css": ".ds-tier{display:inline-flex;align-items:center;gap:6px;margin-right:12px;font:600 12.5px/1.45 Onest,system-ui,sans-serif;color:var(--tinta-2,#C7C7CC)}.ds-tier::before{content:\"\";width:9px;height:9px;border-radius:50%;background:var(--forte,#8E8E93)}.ds-tier.ds-ouro{color:var(--tinta,#F5F5F7)}.ds-tier.ds-ouro::before{background:var(--ouro,#E5B53B);box-shadow:0 0 0 .5px rgba(0,0,0,.2)}.ds-tier.ds-exp::before{background:transparent;box-shadow:inset 0 0 0 1.5px var(--exp,#5E5E63)}"
    },
    {
      "name": "Miniatura com material",
      "kind": "card",
      "refersTo": "thumbnail",
      "description": "Thumb 16:9 com rótulos em material translúcido: Nº, selo de estado com ponto e duração tabular.",
      "html": "<div class=\"ds-cromo\"><span class=\"ds-plaq\">Nº 01–15</span><span class=\"ds-selo\">15 cortes · 2 publicados</span><span class=\"ds-dur\">2:05:36</span></div>",
      "css": ".ds-cromo{position:relative;width:320px;aspect-ratio:16/9;border-radius:var(--raio-p,10px);overflow:hidden;background:linear-gradient(160deg,var(--thumb-2,#3A3A3C),var(--thumb,#2C2C2E));box-shadow:0 0 0 .5px var(--fio,rgba(255,255,255,.09));font:600 11.5px/1 Onest,system-ui,sans-serif;font-variant-numeric:tabular-nums}.ds-cromo span{position:absolute;display:inline-flex;align-items:center;gap:6px;height:20px;padding:0 7px;border-radius:5px;background:var(--material,rgba(20,20,22,.74));color:#fff;-webkit-backdrop-filter:blur(14px) saturate(160%);backdrop-filter:blur(14px) saturate(160%)}.ds-plaq{left:7px;top:7px}.ds-dur{right:7px;bottom:7px}.ds-selo{right:7px;top:7px;height:22px!important;border-radius:6px!important;font-size:12px}.ds-selo::before{content:\"\";width:7px;height:7px;border-radius:50%;background:#30D158}"
    },
    {
      "name": "Poço travado",
      "kind": "card",
      "refersTo": "poco-travado",
      "description": "Espaço impresso esperando a figurinha: diz o que falta e de que depende, sem dado de exemplo.",
      "html": "<div class=\"ds-poco\"><strong>Ao vivo</strong><span class=\"ds-tt\"><svg viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"11\" width=\"14\" height=\"10\" rx=\"2\"/><path d=\"M8 11V7a4 4 0 0 1 8 0v4\"/></svg>Travado · falta configurar</span><span>Falta configurar o app da Twitch (grátis) para ver quem dos seus streamers está ao vivo.</span><small>Cortar a live ao vivo chega na história 5.2.</small><button>Configurar</button></div>",
      "css": ".ds-poco{max-width:420px;display:flex;flex-direction:column;gap:5px;padding:18px 20px;border-radius:var(--raio,12px);background:var(--poco,#232325);box-shadow:inset 0 0 0 .5px var(--fio,rgba(255,255,255,.09));color:var(--tinta-2,#C7C7CC);font:400 13.5px/1.45 Onest,system-ui,sans-serif}.ds-poco strong{font-size:17px;font-weight:650;color:var(--tinta,#F5F5F7)}.ds-tt{display:flex;align-items:center;gap:7px;color:var(--tinta-3,#8E8E93);font-weight:500}.ds-tt svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.ds-poco small{font-size:12.5px;color:var(--tinta-3,#8E8E93)}.ds-poco button{align-self:flex-start;margin-top:8px;height:30px;padding:0 16px;border:0;border-radius:var(--raio-ctrl,7px);background:var(--folha,#2C2C2E);color:var(--tinta,#F5F5F7);font:600 14px/1 Onest,system-ui,sans-serif;box-shadow:0 0 0 .5px var(--fio-forte,rgba(255,255,255,.16));cursor:pointer}.ds-poco button:hover{background:var(--folha-2,#3A3A3C)}.ds-poco button:focus-visible{outline:3px solid var(--foco,rgba(255,106,61,.55));outline-offset:1px}"
    },
    {
      "name": "Opção da Sala",
      "kind": "button",
      "refersTo": "option-toggle",
      "description": "Escolha de formato, enquadramento ou motor; pressionada ganha véu de seleção e contorno queimado.",
      "html": "<div class=\"ds-ops\"><button class=\"ds-op\" aria-pressed=\"true\">9:16 Short</button><button class=\"ds-op\" aria-pressed=\"false\">16:9</button><button class=\"ds-op\" aria-disabled=\"true\">Par Short + Longo · 3.7.3</button></div>",
      "css": ".ds-ops{display:flex;flex-wrap:wrap;gap:8px}.ds-op{display:inline-flex;align-items:center;height:30px;padding:0 12px;border:0;border-radius:var(--raio-ctrl,7px);background:var(--folha-2,#3A3A3C);box-shadow:0 0 0 .5px var(--fio,rgba(255,255,255,.09));color:var(--tinta,#F5F5F7);font:500 14px/1 Onest,system-ui,sans-serif;cursor:pointer}.ds-op:focus-visible{outline:3px solid var(--foco,rgba(255,106,61,.55));outline-offset:1px}.ds-op[aria-pressed=true]{background:var(--selecao,rgba(255,106,61,.16));box-shadow:inset 0 0 0 1.5px var(--acao,#CF4520)}.ds-op[aria-disabled=true]{background:transparent;color:var(--tinta-3,#8E8E93);cursor:not-allowed}"
    },
    {
      "name": "Campo de texto",
      "kind": "input",
      "refersTo": "text-field",
      "description": "Área de texto da ficha da Revisão (título, faixa de 2 s, 1º comentário).",
      "html": "<label class=\"ds-campo\"><span>Faixa de 2 s</span><textarea rows=\"1\">BANHO INTERATIVO NO GTA 6!</textarea></label>",
      "css": ".ds-campo{display:flex;flex-direction:column;gap:5px;width:360px}.ds-campo span{font:700 12px/1.45 Onest,system-ui,sans-serif;color:var(--tinta-3,#8E8E93)}.ds-campo textarea{font:500 14px/1.35 Onest,system-ui,sans-serif;color:var(--tinta,#F5F5F7);resize:none;padding:8px 10px;border:0;border-radius:var(--raio-ctrl,7px);background:var(--folha-2,#3A3A3C);box-shadow:inset 0 0 0 .5px var(--fio-forte,rgba(255,255,255,.16))}.ds-campo textarea:hover{box-shadow:inset 0 0 0 .5px var(--tinta-3,#8E8E93)}.ds-campo textarea:focus{outline:none;box-shadow:inset 0 0 0 .5px var(--fio-forte,rgba(255,255,255,.16)),0 0 0 3px var(--foco,rgba(255,106,61,.55))}"
    },
    {
      "name": "Pico de origem",
      "kind": "custom",
      "description": "Curva real de energia do áudio com o trecho do corte e o cume marcados; só camadas medidas.",
      "html": "<figure class=\"ds-pico\"><svg viewBox=\"0 0 440 84\" preserveAspectRatio=\"none\" aria-label=\"Energia do áudio, corte de 0:33 a 1:24\"><rect class=\"t\" x=\"101\" y=\"0\" width=\"156\" height=\"84\"/><path class=\"a\" d=\"M0,60 L30,40 L60,70 L90,30 L120,50 L150,12 L180,44 L210,24 L240,58 L270,36 L300,66 L330,30 L360,52 L390,20 L440,46 L440,84 L0,84Z\"/><path class=\"l\" d=\"M0,60 L30,40 L60,70 L90,30 L120,50 L150,12 L180,44 L210,24 L240,58 L270,36 L300,66 L330,30 L360,52 L390,20 L440,46\"/><line class=\"c\" x1=\"150\" y1=\"0\" x2=\"150\" y2=\"84\"/></svg><figcaption><span>0:00</span><span>cume em 0:47</span><span>2:24</span></figcaption></figure>",
      "css": ".ds-pico{margin:0;width:440px}.ds-pico svg{width:100%;height:84px;display:block;border-radius:8px;background:var(--poco,#232325)}.ds-pico .t{fill:var(--selecao,rgba(255,106,61,.16))}.ds-pico .a{fill:color-mix(in srgb,var(--marca,#FF6A3D) 16%,transparent)}.ds-pico .l{fill:none;stroke:var(--marca,#FF6A3D);stroke-width:1.4;vector-effect:non-scaling-stroke}.ds-pico .c{stroke:var(--tinta,#F5F5F7);stroke-width:1;stroke-dasharray:3 3;vector-effect:non-scaling-stroke}.ds-pico figcaption{display:flex;justify-content:space-between;margin-top:4px;font:400 11.5px/1 Onest,system-ui,sans-serif;color:var(--tinta-3,#8E8E93);font-variant-numeric:tabular-nums}"
    }
  ],
  "narrative": {
    "northStar": "O Álbum Sendo Completado",
    "overview": "O Estúdio do Criador é um painel local, só desktop (alvo 2560×1440), com acabamento de app de sistema: a referência do dono são os apps do macOS. Cinzas neutros e precisos nos dois temas, sem fundo tingido; uma sidebar translúcida com desfoque; controles segmentados; contagens em cápsula cinza; rótulos sobre as thumbs em material translúcido. A calma vem da familiaridade: nada no chrome compete com as miniaturas, que são o conteúdo.\n\nPor baixo desse acabamento corre um álbum de figurinhas discreto. Cada corte é uma figurinha numerada (Nº 01, Nº 07) e cada função que ainda não existe é o espaço impresso esperando a figurinha: um poço rebaixado que diz o que falta, nunca um número inventado. Do álbum ficam só duas coisas visíveis, a numeração Nº e o encaixe \"colar a figurinha\" quando algo fica pronto. A peça de dado que assina o sistema é o **pico de origem**: a curva real de energia do áudio, por segundo, com o trecho do corte destacado.\n\nA paleta tem uma única voz de marca, o laranja do logotipo, em dois registros: vivo para sinal (seleção, anel da GPU, curvas, ícone ativo) e queimado, com texto branco, para tudo que é preenchido. Verde, amarelo e vermelho existem apenas para estado. O dono recusou explicitamente: azul cobalto ou \"azul de IA\" genérico, o visual preto e branco de loja, SaaS genérico, gamer RGB, clone do YouTube Studio, paletas tingidas de álbum, carimbos em caixa alta, nota do Editor-Chefe na tela e mini-curva de pico por item de lista.",
