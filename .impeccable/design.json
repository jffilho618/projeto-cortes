    {
      "name": "Botão principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ação principal: invertido em repouso, laranja-brasa no hover.",
      "html": "<button class=\"ds-bt ds-bt-pri\">Registrar autorização</button>",
      "css": ".ds-bt{font:600 var(--t-dado,0.875rem)/1.2 var(--fonte-ui,Archivo,system-ui,sans-serif);padding:9px 14px;border-radius:99px;border:0;cursor:pointer;transition:background var(--dur-curta,160ms) var(--ease-saida,cubic-bezier(.16,1,.3,1)),color var(--dur-curta,160ms) var(--ease-saida,cubic-bezier(.16,1,.3,1))}.ds-bt-pri{background:var(--texto,#f1f1f1);color:var(--fundo,#0f0f10)}.ds-bt-pri:hover{background:var(--marca,#ff6a3d);color:var(--marca-texto,#16120f)}.ds-bt:focus-visible{outline:2px solid var(--marca,#ff6a3d);outline-offset:2px}.ds-bt:disabled{opacity:.45;cursor:not-allowed}"
    },
    {
      "name": "Botão secundário",
